

{
  "manifest_version": 3,

  "name": "ResumeFit AI",

  "version": "1.0.0",

  "description": "AI powered ATS resume matcher extension",

  "action": {
    "default_popup": "index.html",
    "default_title": "ResumeFit AI"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://*/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"]
    }
  ]
}
